create_power_domain PD_AON \
  -elements { . }

create_power_domain PD_SW \
  -elements { u_functional_top }

set_isolation iso_sw \
  -domain PD_SW \
  -applies_to outputs \
  -clamp_value 0

set_isolation iso_sw \
  -domain PD_SW \
  -update \
  -isolation_signal iso_en_n \
  -isolation_sense low

set_isolation iso_sw \
  -domain PD_SW \
  -update \
  -location parent

use_interface_cell PD_SW \
  -domain PD_SW \
  -strategy iso_sw \
  -lib_cells {sky130_fd_sc_hd__lpflow_inputiso0n_1}

# Logical intent only. No map_power_switch is issued because the pinned
# SKY130HD platform has no qualified physical switch master (POWER-000 B).
# power_off_intent is already a design net/output; a duplicate UPF logic port
# would conflict when OpenROAD materializes logic-port nets.

create_power_switch sw_logical \
  -domain PD_SW \
  -output_supply_port {switched VDD_SW} \
  -input_supply_port {input VDD_AON} \
  -control_port {enable power_off_intent}
